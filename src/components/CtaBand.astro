---
import { img } from '../data/photos';
import { whatsappLink } from '../data/site';

interface Props {
  title?: string;
  image?: string;
}

const { title = 'Let’s create something beautiful in Izmir', image = 'photo-1775717522396-5d56c0c9aeae' } = Astro.props;
---

<section class="cta">
  <img class="cta__bg" src={img(image, 2000)} alt="" loading="lazy" data-parallax="12" />
  <div class="wrap cta__inner">
    <span class="eyebrow reveal">Dates for 2026 & 2027 are filling up</span>
    <h2 data-split>{title}</h2>
    <p class="reveal">Tell me your date and where you are staying. I usually reply within a few hours.</p>
    <div class="cta__buttons reveal">
      <a class="btn btn--light" href="/contact/">Check availability</a>
      <a class="btn btn--light btn--outline" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    color: #fff;
    text-align: center;
    padding: clamp(96px, 14vw, 180px) 0;
    background: var(--ink);
  }
  .cta__bg {
    position: absolute;
    left: 0;
    top: -15%;
    width: 100%;
    height: 130%;
    object-fit: cover;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(25, 20, 17, 0.52);
  }
  .cta__inner {
    position: relative;
    z-index: 1;
  }
  .cta .eyebrow {
    color: #f1e6da;
  }
  .cta h2 {
    max-width: 18ch;
    margin: 0 auto 0.4em;
  }
  .cta p {
    max-width: 46ch;
    margin: 0 auto 2rem;
    opacity: 0.9;
  }
  .cta__buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn--outline {
    background: transparent;
    color: #fff;
  }
  .btn--outline:hover {
    background: #fff;
    color: var(--ink);
  }
</style>

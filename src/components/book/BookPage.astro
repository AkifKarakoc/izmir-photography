---
// One page of a book album. Which page types appear depends on the album
// style; how each looks is styled per style in Book.astro.
import Photo from '../Photo.astro';
import type { RenderedPage } from '../../data/albums';

interface Props {
  page: RenderedPage;
}

const { page: p } = Astro.props;
const dark = ['word', 'filmstrip', 'darkfull'].includes(p.type);
const cls = ['page', 'paper', `p-${p.type}`, 'side' in p ? `p-${p.type}--${p.side}` : '', dark ? 'is-dark' : ''].join(' ');
---

<div class={cls}>
  {
    p.type === 'title' && (
      <div class="p-title__inner">
        {p.eyebrow && <span class="eyebrow">{p.eyebrow}</span>}
        <h2>{p.title}</h2>
        {p.text && <p><em>{p.text}</em></p>}
        {p.cta && <a class="btn" href="/contact/">Check availability</a>}
      </div>
    )
  }

  {p.type === 'full' && <Photo class="fill" photo={p.photo} width={1000} loading="eager" />}

  {
    p.type === 'framed' && (
      <>
        <div class="frame"><Photo class="fill" photo={p.photo} width={900} loading="eager" /></div>
        {p.caption && <p class="caption">{p.caption}</p>}
      </>
    )
  }

  {
    (p.type === 'stack' || p.type === 'quad') && (
      <div class="grid">
        {p.photos.map((ph) => (
          <div class="frame"><Photo class="fill" photo={ph} width={700} loading="eager" /></div>
        ))}
      </div>
    )
  }

  {
    p.type === 'offset' && (
      <>
        <div class="frame"><Photo class="fill" photo={p.photo} width={800} loading="eager" /></div>
        <p class="note">{p.text}</p>
      </>
    )
  }

  {
    p.type === 'closing' && (
      <div class="p-closing__inner">
        <div class="frame"><Photo class="fill" photo={p.photo} width={700} loading="eager" /></div>
        <p class="caption">Thank you</p>
      </div>
    )
  }

  {
    p.type === 'note' && (
      <div class="p-note__inner">
        <p class="note">{p.text}</p>
        {p.sub && <p class="note note--sub">{p.sub}</p>}
      </div>
    )
  }

  {
    p.type === 'pano' && (
      <>
        <div class="half-photo"><Photo photo={p.photo} width={1600} loading="eager" /></div>
        <p class="note">{p.text}</p>
      </>
    )
  }

  {
    p.type === 'spread' && (
      <>
        <div class="half-photo"><Photo photo={p.photo} width={2000} loading="eager" /></div>
        {p.caption && <p class="caption caption--light">{p.caption}</p>}
      </>
    )
  }

  {p.type === 'blank' && <span class="blank-mark" aria-hidden="true" />}

  <!-- Cinematic -->
  {
    p.type === 'word' && (
      <div class="p-word__inner">
        <p class="word">{p.word}</p>
        {p.caption && <span class="stamp-time">{p.caption}</span>}
      </div>
    )
  }

  {
    p.type === 'filmstrip' && (
      <div class="film">
        {p.photos.map((ph, i) => (
          <figure class="film__frame">
            <Photo class="fill" photo={ph} width={600} loading="eager" />
            {p.captions?.[i] && <figcaption>{p.captions[i]}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }

  {
    p.type === 'scene' && (
      <>
        <div class="frame"><Photo class="fill" photo={p.photo} width={800} loading="eager" /></div>
        {p.caption && <span class="stamp-time">{p.caption}</span>}
      </>
    )
  }

  {
    p.type === 'darkfull' && (
      <>
        <div class="frame"><Photo class="fill" photo={p.photo} width={1000} loading="eager" /></div>
        {p.caption && <span class="stamp-time">{p.caption}</span>}
      </>
    )
  }

  <!-- Journal -->
  {
    p.type === 'polaroids' && (
      <>
        {p.photos.map((ph, i) => (
          <figure class={`polaroid polaroid--${i + 1}`}>
            <Photo photo={ph} width={500} loading="eager" />
            <figcaption>{p.captions[i]}</figcaption>
          </figure>
        ))}
      </>
    )
  }

  {
    p.type === 'taped' && (
      <>
        <div class="print print--taped"><Photo class="fill" photo={p.photo} width={900} loading="eager" /></div>
        <p class="hand">{p.note}</p>
      </>
    )
  }

  {
    p.type === 'stamp' && (
      <>
        <div class="postmark">
          <strong>{p.place}</strong>
          <span>{p.coords}</span>
        </div>
        <p class="hand">{p.note}</p>
        <div class="print print--taped"><Photo class="fill" photo={p.photo} width={800} loading="eager" /></div>
      </>
    )
  }

  {
    p.type === 'collage' && (
      <>
        {p.photos.map((ph, i) => (
          <div class={`print collage--${i + 1}`}><Photo class="fill" photo={ph} width={700} loading="eager" /></div>
        ))}
        {p.note && <p class="hand">{p.note}</p>}
      </>
    )
  }
</div>

---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import { photos, img, srcset } from '../data/photos';
import { services, locations, faqs, testimonials } from '../data/site';

const featured = photos.slice(0, 9);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Wedding & Proposal Photographer in Izmir | Alaçatı, Çeşme, Urla"
  description="English-speaking wedding, proposal and couple photographer in Izmir, Turkey. Natural, timeless photos in Alaçatı, Çeşme, Urla, Şirince and Ephesus."
  transparentHeader
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="hero" data-hero>
    <img
      class="hero__img"
      data-hero-img
      src={img('photo-1779475501433-69a3a0b310f8', 1800)}
      srcset={srcset('photo-1779475501433-69a3a0b310f8')}
      sizes="100vw"
      alt="Newlyweds walking through a vineyard near Izmir"
      fetchpriority="high"
    />
    <div class="hero__content wrap">
      <span class="eyebrow" data-hero-fade>Izmir · Alaçatı · Çeşme · Urla · Şirince</span>
      <h1>Wedding & Proposal<br /><em>Photographer in Izmir</em></h1>
      <p data-hero-fade>Timeless, natural photographs of your love story on the Aegean coast.</p>
      <div class="hero__buttons" data-hero-fade>
        <a class="btn btn--light" href="/contact/">Check availability</a>
        <a class="btn btn--light hero__ghost" href="/portfolio/">View portfolio</a>
      </div>
    </div>
    <a href="#intro" class="hero__scroll" aria-label="Scroll down"></a>
  </section>

  <!-- Intro -->
  <section class="section" id="intro">
    <div class="wrap intro">
      <div class="intro__img" data-reveal-img>
        <img src={img('photo-1519741497674-611481863552', 900)} alt="Bride and groom portrait" loading="lazy" />
      </div>
      <div class="intro__text reveal">
        <span class="eyebrow">Hello, I’m [Name]</span>
        <h2 data-split>Your story, told <em>honestly</em> and beautifully</h2>
        <p class="lead">
          I’m a photographer based in Izmir, capturing weddings, surprise proposals and couples on holiday along the
          Aegean coast. My style is calm, natural and full of real emotion: no stiff poses, just the two of you.
        </p>
        <p>
          Whether you are flying in for a destination wedding or planning a secret proposal during your trip, I’ll help
          you find the perfect light, the perfect spot and the perfect moment. I speak English and handle everything
          from planning to delivery.
        </p>
        <a class="link" href="/about/">More about me</a>
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1, 2, 3].map(() => ['Alaçatı', 'Çeşme', 'Urla', 'Şirince', 'Ephesus', 'Kordon'].map((n) => <><span>{n}</span><span>✦</span></>))}
    </div>
  </div>

  <!-- Services -->
  <section class="section section--alt" id="services">
    <div class="wrap">
      <div class="center reveal">
        <span class="eyebrow">What I photograph</span>
        <h2 data-split>Sessions & Services</h2>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <a href={`/${s.slug}/`} class="service">
              <div class="service__img" data-reveal-img>
                <img src={img(s.cover, 800)} alt={s.h1} loading="lazy" />
              </div>
              <h3>{s.title}</h3>
              <p>{s.short}</p>
              <span class="link">Discover</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured gallery -->
  <section class="section">
    <div class="wrap">
      <div class="center reveal">
        <span class="eyebrow">Recent work</span>
        <h2 data-split>Moments from the Aegean</h2>
      </div>
      <div style="margin-top:48px">
        <Gallery photos={featured} />
      </div>
      <div class="center" style="margin-top:40px">
        <a class="btn btn--ghost" href="/portfolio/">See full portfolio</a>
      </div>
    </div>
  </section>

  <!-- Locations -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="locations__head reveal">
        <div>
          <span class="eyebrow">Where we can shoot</span>
          <h2 data-split>Favourite locations around Izmir</h2>
        </div>
        <a class="link" href="/locations/">All locations</a>
      </div>
      <div class="locations">
        {
          locations.map((l) => (
            <a href={`/locations/${l.slug}/`} class="location" data-reveal-img>
              <img src={img(l.cover, 700)} alt={`${l.name}, Izmir`} loading="lazy" />
              <div class="location__label">
                <h3>{l.name}</h3>
                <p>{l.blurb}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="wrap">
      <div class="center reveal">
        <span class="eyebrow">Simple & stress-free</span>
        <h2 data-split>How it works</h2>
      </div>
      <ol class="steps">
        <li class="reveal">
          <span class="steps__num">01</span>
          <h3>Say hello</h3>
          <p>Send your date, the type of shoot and where you are staying in Izmir.</p>
        </li>
        <li class="reveal">
          <span class="steps__num">02</span>
          <h3>Plan together</h3>
          <p>We choose the location and the best light. For proposals, we plan every detail of the surprise.</p>
        </li>
        <li class="reveal">
          <span class="steps__num">03</span>
          <h3>Enjoy your gallery</h3>
          <p>A sneak peek in 48 hours, then your full edited gallery to download and share.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--alt">
    <div class="wrap">
      <div class="center reveal">
        <span class="eyebrow">Kind words</span>
        <h2 data-split>From our couples</h2>
      </div>
      <div class="quotes">
        {
          testimonials.map((t) => (
            <figure class="quote reveal">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                {t.name} · {t.from}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap faq">
      <div class="reveal">
        <span class="eyebrow">Good to know</span>
        <h2 data-split>Frequently asked questions</h2>
      </div>
      <div class="faq__list reveal">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    background: var(--ink); /* the photo fades in from dark, not from cream */
    height: 100svh;
    min-height: 560px;
    color: #fff;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 16, 13, 0.35) 0%, rgba(20, 16, 13, 0.05) 35%, rgba(20, 16, 13, 0.6) 100%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: clamp(72px, 12vh, 140px);
  }
  .hero .eyebrow {
    color: #f3e9de;
  }
  .hero h1 em {
    font-weight: 400;
  }
  .hero p {
    font-size: 1.2rem;
    max-width: 40ch;
    opacity: 0.92;
  }
  .hero__buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .hero__ghost {
    background: transparent;
    color: #fff;
  }
  .hero__ghost:hover {
    background: #fff;
    color: var(--ink);
  }
  .hero__scroll {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 28px;
    width: 1px;
    height: 48px;
    background: linear-gradient(#fff, transparent);
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .intro__img img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 56px;
  }
  .service {
    text-decoration: none;
    display: block;
  }
  .service__img {
    overflow: hidden;
    margin-bottom: 24px;
  }
  .service img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .service:hover img {
    transform: scale(1.04);
  }
  .service p {
    color: var(--muted);
  }

  .locations__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .locations {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }
  .location {
    position: relative;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }
  .location img {
    width: 100%;
    aspect-ratio: 3 / 4.4;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .location:hover img {
    transform: scale(1.05);
  }
  .location::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 40%, rgba(20, 16, 13, 0.7));
  }
  .location__label {
    position: absolute;
    z-index: 1;
    left: 18px;
    right: 18px;
    bottom: 14px;
  }
  .location__label h3 {
    font-size: 1.5rem;
    margin-bottom: 0.2em;
  }
  .location__label p {
    font-size: 0.85rem;
    line-height: 1.4;
    opacity: 0.85;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 56px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  .steps li {
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .steps__num {
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--accent);
  }
  .steps p {
    color: var(--muted);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-top: 56px;
  }
  .quote {
    margin: 0;
    padding: 40px 32px;
    background: var(--bg);
  }
  .quote blockquote {
    margin: 0 0 1.5em;
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.45;
    font-style: italic;
  }
  .quote figcaption {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .faq {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(32px, 6vw, 96px);
  }
  .faq details {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .faq summary {
    cursor: pointer;
    list-style: none;
    font-family: var(--serif);
    font-size: 1.45rem;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--sans);
    font-weight: 200;
    transition: transform 0.3s;
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq details p {
    color: var(--muted);
    margin: 12px 0 0;
  }

  @media (max-width: 1000px) {
    .locations {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 820px) {
    .intro,
    .faq {
      grid-template-columns: 1fr;
    }
    .services,
    .steps,
    .quotes {
      grid-template-columns: 1fr;
    }
    .service img {
      aspect-ratio: 4 / 3;
    }
    .locations {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

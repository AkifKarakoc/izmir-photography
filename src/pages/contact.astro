---
import Base from '../layouts/Base.astro';
import { img } from '../data/photos';
import { site, whatsappLink, services, locations } from '../data/site';
---

<Base
  title="Contact & Availability | Izmir Wedding & Proposal Photographer"
  description="Check availability for your wedding, proposal or couple photoshoot in Izmir. Reply within a few hours via WhatsApp or email."
>
  <section class="section">
    <div class="wrap contact">
      <div>
        <span class="eyebrow">Contact</span>
        <h1 data-split>Let’s plan <em>your session</em></h1>
        <p class="lead">Tell me a little about your plans. I usually reply within a few hours.</p>
        <a class="btn wa" href={whatsappLink()} target="_blank" rel="noopener">Message on WhatsApp</a>
        <p class="alt">
          or email <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <img src={img('photo-1542286777-b6499aa99a0a', 900)} alt="Engagement ring moment" loading="lazy" />
      </div>

      <!-- Draft form: will be connected to a free form service (e.g. Netlify Forms) before launch -->
      <form class="form reveal" onsubmit="event.preventDefault(); this.querySelector('.form__note').hidden = false;">
        <label>Your names<input name="names" required placeholder="e.g. Emma & James" /></label>
        <label>Email<input name="email" type="email" required /></label>
        <label>WhatsApp number (optional)<input name="phone" type="tel" /></label>
        <div class="form__row">
          <label>Type of shoot
            <select name="type">
              {services.map((s) => <option>{s.title}</option>)}
            </select>
          </label>
          <label>Date<input name="date" type="date" /></label>
        </div>
        <label>Location
          <select name="location">
            {locations.map((l) => <option>{l.name}</option>)}
            <option>Not sure yet</option>
          </select>
        </label>
        <label>Tell me about your plans<textarea name="message" rows="5"></textarea></label>
        <button class="btn" type="submit">Send enquiry</button>
        <p class="form__note" hidden>This is a draft. The form will be connected before the site goes live.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .wa {
    background: #25d366;
    border-color: #25d366;
    color: #fff;
  }
  .wa:hover {
    color: #1a9e4b;
  }
  .alt {
    margin-top: 1rem;
    color: var(--muted);
  }
  .contact img {
    margin-top: 40px;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .form {
    display: grid;
    gap: 20px;
    background: var(--bg-alt);
    padding: clamp(24px, 4vw, 48px);
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .form label {
    display: grid;
    gap: 6px;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .form input,
  .form select,
  .form textarea {
    font: inherit;
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 12px 14px;
    border-radius: 0;
    width: 100%;
  }
  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: 1px solid var(--ink);
  }
  .form__note {
    color: var(--accent);
    margin: 0;
  }
  @media (max-width: 820px) {
    .contact,
    .form__row {
      grid-template-columns: 1fr;
    }
  }
</style>

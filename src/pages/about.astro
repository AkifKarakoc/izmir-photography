---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { img } from '../data/photos';
---

<Base
  title="About | Izmir Wedding & Proposal Photographer"
  description="Meet the photographer behind the camera: based in Izmir, English-speaking, specialised in weddings, proposals and couples on the Aegean coast."
>
  <section class="section">
    <div class="wrap about">
      <div data-reveal-img>
        <img src={img('photo-1460978812857-470ed1c77af0', 1000)} alt="Photographer portrait placeholder" />
      </div>
      <div>
        <span class="eyebrow">About me</span>
        <h1 data-split>Hi, I’m <em>[Name]</em></h1>
        <p class="lead">
          This is where the photographer introduces themselves: who they are, how they started and why they love
          photographing couples in Izmir.
        </p>
        <p>
          A personal, warm introduction builds trust with couples who are booking from abroad. Two or three short
          paragraphs are enough: the style of work, years of experience, languages spoken and a small personal detail
          (favourite spot in Izmir, coffee or tea, a fun fact).
        </p>
        <p>
          This text will be written together with the photographer and can be edited at any time from the admin panel.
        </p>
        <div class="numbers">
          <div><strong>—</strong><span>Weddings</span></div>
          <div><strong>—</strong><span>Proposals</span></div>
          <div><strong>—</strong><span>Years</span></div>
        </div>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .about img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .numbers {
    display: flex;
    gap: 48px;
    margin-top: 40px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .numbers strong {
    display: block;
    font-family: var(--serif);
    font-size: 2.6rem;
    font-weight: 400;
  }
  .numbers span {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>

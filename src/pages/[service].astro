---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import AlbumShelf from '../components/book/AlbumShelf.astro';
import { getAlbums } from '../data/albums';
import { photos, img } from '../data/photos';
import { services, locations, type Service } from '../data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Service };
const gallery = photos.filter((p) => p.category === s.category).concat(photos.filter((p) => p.category !== s.category)).slice(0, 6);
const others = services.filter((o) => o.slug !== s.slug);
---

<Base
  title={`${s.h1} | English-speaking photographer`}
  description={s.intro.slice(0, 155)}
  image={s.cover}
  transparentHeader
>
  <section class="banner" data-hero>
    <img class="banner__img" src={img(s.cover, 2000)} alt={s.h1} data-hero-img fetchpriority="high" />
    <div class="wrap hero__content">
      <span class="eyebrow" data-hero-fade>{s.title}</span>
      <h1>{s.h1}</h1>
    </div>
  </section>

  <section class="section">
    <div class="wrap detail">
      <div>
        <p class="lead reveal">{s.intro}</p>
        <p>
          Popular locations include
          {locations.map((l, i) => (
            <>
              <a href={`/locations/${l.slug}/`}>{l.name}</a>{i < locations.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
      </div>
      <aside class="package reveal">
        <span class="eyebrow">Package</span>
        <p class="package__price">{s.from ? `Starting from ${s.from}` : 'Price on request'}</p>
        <ul>
          {s.includes.map((i) => <li>{i}</li>)}
        </ul>
        <a class="btn" href="/contact/">Check availability</a>
      </aside>
    </div>
  </section>

  <section class="wrap" style="padding-bottom:96px">
    <Gallery photos={gallery} />
  </section>

  <AlbumShelf albums={await getAlbums({ category: s.category })} title={`${s.title} albums`} />

  <section class="section section--alt">
    <div class="wrap">
      <span class="eyebrow reveal">You might also like</span>
      <div class="others">
        {
          others.map((o) => (
            <a href={`/${o.slug}/`}>
              <div data-reveal-img>
                <img src={img(o.cover, 700)} alt={o.h1} loading="lazy" />
              </div>
              <h3>{o.h1}</h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .banner {
    position: relative;
    overflow: hidden;
    min-height: 70svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: 64px;
    color: #fff;
    background: var(--ink);
  }
  .banner__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(20, 16, 13, 0.25), rgba(20, 16, 13, 0.6));
  }
  .banner .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .banner .eyebrow {
    color: #f1e6da;
  }
  .detail {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .package {
    background: var(--bg-alt);
    padding: 40px;
  }
  .package__price {
    font-family: var(--serif);
    font-size: 2rem;
  }
  .package ul {
    padding: 0;
    margin: 0 0 2rem;
    list-style: none;
  }
  .package li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .others {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }
  .others a {
    text-decoration: none;
  }
  .others img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    width: 100%;
    margin-bottom: 16px;
  }
  @media (max-width: 820px) {
    .detail,
    .others {
      grid-template-columns: 1fr;
    }
  }
</style>
